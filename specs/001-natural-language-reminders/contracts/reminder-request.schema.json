{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReminderRequest",
  "type": "object",
  "properties": {
    "request": {
      "type": "string",
      "minLength": 1
    },
    "reference_context": {
      "type": "object",
      "properties": {
        "current_datetime": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "$ref": "#/$defs/timezone"
        }
      },
      "required": [
        "current_datetime",
        "timezone"
      ],
      "additionalProperties": false
    },
    "existing_reminders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reminder"
      }
    }
  },
  "required": [
    "request"
  ],
  "additionalProperties": false,
  "$defs": {
    "timezone": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reminder": {
      "type": "object",
      "properties": {
        "reminder_id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "$ref": "#/$defs/timezone"
        }
      },
      "required": [
        "reminder_id",
        "task",
        "date",
        "time",
        "timezone"
      ],
      "additionalProperties": false
    }
  }
}
